{
  "coverage_id": "oem_cn_l2l3_v1",
  "label_zh": "ODD 判据维度 × 主机厂覆盖度分层（中国量产 L2+/L3 口径）",
  "as_of": "2026-11",
  "scope_zh": "中国量产 L2+/L3 参照系（理想 / 小鹏 / 华为 ADS / 蔚来 / 比亚迪 TJP）的公开资料推断；不含 Robotaxi 与国际 OEM 对比",
  "evidence_basis": [
    "厂商用户手册 / 智能驾驶功能说明书的 ODD 章节",
    "GB/T 45312 智能驾驶 TJP 准入要求、GB/T 43267 自动驾驶功能通用要求",
    "ISO 34503 ODD 要素与声明格式",
    "公开召回、事故调查与功能退出/接管提示的产品形态"
  ],
  "tier_definitions": {
    "mandatory": "法规或准入文件要求，量产功能激活/退出必须依赖；几乎所有主机厂做",
    "mainstream": "无量产强标逐条要求，但不做会在常见场景出事或影响可用性；量产主流都做",
    "leading": "自研 Tier1、城市 NOA 或 L3 安全论证才做；多数主机厂仅写入手册而不上线判据",
    "rare": "基本不做的维度；量产的等价物是简化监测，而非该维度本身"
  },
  "source_enum": ["perception", "map_adas", "chassis", "dms", "static_config", "inference"],
  "source_definitions_zh": {
    "perception": "环境感知链路的在线输出（视觉/激光/融合）",
    "map_adas": "ADAS 地图 + 高精定位链路，感知不参与兜底",
    "chassis": "底盘/车身 CAN 信号（车速、横摆角速度、IMU）",
    "dms": "驾驶员监控子系统，独立于环境感知",
    "static_config": "静态配置/白名单/OTA 下发的 ODD 声明值",
    "inference": "由其他信号间接推断，无量测量"
  },
  "layer_enum": ["declared", "online_judged", "closed_loop_verified"],
  "layer_definitions_zh": {
    "declared": "写进用户手册、功能说明书或安全论证的 ODD 条目",
    "online_judged": "运行时存在判据、能触发降级/接管/MRM 提示（含 gate 型判据）",
    "closed_loop_verified": "判据有可量测的感知输入 + 定量阈值 + 可审计记录"
  },
  "summary_zh": {
    "declared": 17,
    "online_judged": 12,
    "stable_degradation": 8,
    "closed_loop_verified": 6,
    "note": "online_judged 中的 ood_confidence 是 gate 而非独立维度，按独立维度口径为 11；stable_degradation 指真正会造成功能降级/退出请求的判据数，介于两者之间。四个数字的含义不同，不可混用。"
  },
