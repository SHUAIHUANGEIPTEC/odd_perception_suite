{
  "profile_id": "byd_tjp",
  "label_zh": "比亚迪 TJP 交通拥堵自动驾驶 ODD",
  "definition_mode": "restrictive",
  "missing_policy": {
    "by_element": {"ODC.7.1.5.robc": "undefined"},
    "by_tag": {"road": "undefined", "scenery": "undefined", "dynamic": "undefined"},
    "default": "mode"
  },
  "extends": null,
  "elements": [
    {
      "element_id": "ODC.1.1.1.road_type",
      "path": ["道路特征", "道路类型"],
      "label_zh": "道路类型",
      "requirement": "allowed",
      "rule_type": "qualitative_enum",
      "observation_key": "scenery.road_type",
      "qualifier": "include",
      "allowed_values": ["expressway_main", "highway_main"],
      "forbidden_values": ["urban_arterial", "urban_minor", "urban_branch", "rural_road", "highway_l1", "highway_l2", "highway_l3", "highway_l4", "other_road"],
      "tags": ["road", "scenery"],
      "warning_codes": {"outside": "ODD-ROAD-TYPE-001"},
      "message_zh": "道路类型须为高速/快速路主路"
    },
    {
      "element_id": "ODC.1.1.2.road_area",
      "path": ["道路特征", "区域"],
      "label_zh": "运行区域",
      "requirement": "allowed",
      "rule_type": "qualitative_bool",
      "observation_key": "scenery.legal_l3_area",
      "expect": true,
      "tags": ["road", "scenery"],
      "warning_codes": {"outside": "ODD-AREA-001"}
    },
    {
      "element_id": "ODC.1.2.1.curve_radius",
      "path": ["道路特征", "道路几何", "平面", "曲率半径"],
      "label_zh": "曲率半径",
      "requirement": "allowed",
      "rule_type": "numeric_range",
      "observation_key": "scenery.curve_radius_m",
      "op": ">=",
      "threshold": 200.0,
      "boundary_margin": {"mode": "absolute", "value": 20.0},
      "applies_when": {"all_of": [{"key": "scenery.road_type", "op": "in", "value": ["expressway_main", "highway_main"]}]},
      "tags": ["road", "geometry", "scenery"],
      "warning_codes": {"boundary": "ODD-GEO-RADIUS-NEAR", "outside": "ODD-GEO-RADIUS-001"}
    },
    {
      "element_id": "ODC.1.2.2.longitudinal_grade",
      "path": ["道路特征", "道路几何", "纵断面"],
      "label_zh": "纵坡",
      "requirement": "allowed",
      "rule_type": "numeric_range",
      "observation_key": "scenery.longitudinal_grade_pct",
      "op": "between",
      "range": [-9.0, 9.0],
      "boundary_margin": {"mode": "absolute", "value": 0.9},
      "tags": ["road", "geometry", "scenery"],
      "warning_codes": {"boundary": "ODD-GEO-GRADE-NEAR", "outside": "ODD-GEO-GRADE-001"}
    },
    {
      "element_id": "ODC.1.2.3.cross_slope",
      "path": ["道路特征", "道路几何", "横断面", "横坡"],
      "label_zh": "横坡/超高",
      "requirement": "allowed",
      "rule_type": "numeric_range",
      "observation_key": "scenery.cross_slope_pct",
      "op": "between",
      "range": [-2.0, 2.0],
      "boundary_margin": {"mode": "absolute", "value": 0.2},
      "tags": ["road", "geometry", "scenery"],
      "warning_codes": {"boundary": "ODD-GEO-SLOPE-NEAR", "outside": "ODD-GEO-SLOPE-001"}
    },
    {
      "element_id": "ODC.1.2.4.lane_width",
      "path": ["道路特征", "车道特征", "车道宽度"],
      "label_zh": "车道宽度",
      "requirement": "allowed",
      "rule_type": "numeric_range",
      "observation_key": "scenery.lane_width_m",
      "op": "between",
      "range": [2.5, 5.5],
      "boundary_margin": {"mode": "absolute", "value": 0.2},
      "tags": ["road", "lane", "scenery"],
      "warning_codes": {"boundary": "ODD-LANE-WIDTH-NEAR", "outside": "ODD-LANE-WIDTH-001"}
    },
    {
      "element_id": "ODC.1.3.1.marking_clear",
      "path": ["道路特征", "道路交通标线", "标线质量"],
      "label_zh": "标线清晰",
      "requirement": "allowed",
      "rule_type": "qualitative_bool",
      "observation_key": "scenery.marking_clear",
      "expect": true,
      "tags": ["road", "marking", "scenery"],
      "warning_codes": {"outside": "SCN-LANE-01"}
    },
    {
      "element_id": "ODC.1.3.2.no_marking",
      "path": ["道路特征", "道路交通标线", "无道路标线"],
      "label_zh": "无道路交通标线",
      "requirement": "not_allowed",
      "rule_type": "qualitative_bool",
      "observation_key": "scenery.has_no_marking",
      "expect": true,
      "tags": ["road", "marking", "scenery"],
      "warning_codes": {"outside": "SCN-LANE-03"}
    },
    {
      "element_id": "ODC.1.4.1.intersection",
      "path": ["道路特征", "道路交叉", "平面交叉"],
      "label_zh": "平面交叉路口",
      "requirement": "not_allowed",
      "rule_type": "qualitative_bool",
      "observation_key": "scenery.has_intersection",
      "expect": true,
      "tags": ["road", "junction", "scenery"],
      "warning_codes": {"outside": "SCN-JCT-01"}
    },
    {
      "element_id": "ODC.1.4.2.roundabout",
      "path": ["道路特征", "道路交叉", "环岛"],
      "label_zh": "环岛",
      "requirement": "not_allowed",
      "rule_type": "qualitative_bool",
      "observation_key": "scenery.has_roundabout",
      "expect": true,
      "tags": ["road", "junction", "scenery"],
      "warning_codes": {"outside": "SCN-JCT-02"}
    },
    {
      "element_id": "ODC.1.4.3.ramp",
      "path": ["道路特征", "道路交叉", "匝道"],
      "label_zh": "匝道",
      "requirement": "not_allowed",
      "rule_type": "qualitative_bool",
      "observation_key": "scenery.has_ramp",
      "expect": true,
      "tags": ["road", "junction", "scenery"],
      "warning_codes": {"outside": "ODD-JCT-RAMP-001"}
    },
    {
      "element_id": "ODC.1.4.4.toll_station",
      "path": ["道路特征", "特殊设施", "收费站"],
      "label_zh": "收费站",
      "requirement": "not_allowed",
      "rule_type": "qualitative_bool",
      "observation_key": "scenery.has_toll_station",
      "expect": true,
      "tags": ["road", "structure", "scenery"],
      "warning_codes": {"outside": "SCN-STR-03"}
    },
    {
      "element_id": "ODC.1.4.5.railway_crossing",
      "path": ["道路特征", "特殊设施", "铁路交叉"],
      "label_zh": "铁路交叉",
      "requirement": "not_allowed",
      "rule_type": "qualitative_bool",
      "observation_key": "scenery.has_railway_crossing",
      "expect": true,
      "tags": ["road", "structure", "scenery"],
      "warning_codes": {"outside": "SCN-STR-04"}
    },
    {
      "element_id": "ODC.1.4.6.construction",
      "path": ["道路特征", "道路临时设施", "道路施工"],
      "label_zh": "道路施工",
      "requirement": "not_allowed",
      "rule_type": "qualitative_bool",
      "observation_key": "scenery.construction_zone",
      "expect": true,
      "tags": ["road", "temporary", "scenery"],
      "warning_codes": {"outside": "SCN-SIGN-04"}
    },
    {
      "element_id": "ODC.1.4.7.accident_scene",
      "path": ["道路特征", "道路临时设施", "事故现场"],
      "label_zh": "事故现场",
      "requirement": "not_allowed",
      "rule_type": "qualitative_bool",
      "observation_key": "scenery.accident_scene",
      "expect": true,
      "tags": ["road", "temporary", "scenery"],
      "warning_codes": {"outside": "ODD-TEMP-ACC-001"}
    },
    {
      "element_id": "ODC.1.4.8.traffic_control",
      "path": ["道路特征", "道路临时设施", "交通管制"],
      "label_zh": "交通管制",
      "requirement": "not_allowed",
      "rule_type": "qualitative_bool",
      "observation_key": "scenery.traffic_control",
      "expect": true,
      "tags": ["road", "temporary", "scenery"],
      "warning_codes": {"outside": "ODD-TEMP-CTRL-001"}
    },
    {
      "element_id": "ODC.2.1.1.speed",
      "path": ["车辆运动状态", "速度", "运行速度"],
      "label_zh": "运行速度",
      "requirement": "allowed",
      "rule_type": "numeric_range",
      "observation_key": "vehicle.speed_kmh",
      "op": "between",
      "range": [0.0, 80.0],
      "boundary_margin": {"mode": "absolute", "value": 3.0},
      "tags": ["vehicle", "motion"],
      "warning_codes": {"boundary": "ODD-SPD-NEAR", "outside": "ODD-SPD-001"}
    },
    {
      "element_id": "ODC.2.1.2.activation_speed",
      "path": ["车辆运动状态", "速度", "激活速度"],
      "label_zh": "激活速度",
      "requirement": "allowed",
      "rule_type": "numeric_range",
      "observation_key": "vehicle.activation_speed_kmh",
      "op": "between",
      "range": [0.0, 80.0],
      "boundary_margin": {"mode": "absolute", "value": 3.0},
      "tags": ["vehicle", "motion"],
      "warning_codes": {"boundary": "ODD-SPD-ACT-NEAR", "outside": "ODD-SPD-ACT-001"}
    },
    {
      "element_id": "ODC.2.1.3.lat_accel",
      "path": ["车辆运动状态", "加速度", "运行加速度", "横向"],
      "label_zh": "横向加速度",
      "requirement": "allowed",
      "rule_type": "numeric_range",
      "observation_key": "vehicle.lat_accel_mps2",
      "op": "between",
      "range": [-2.0, 2.0],
      "boundary_margin": {"mode": "absolute", "value": 0.2},
      "tags": ["vehicle", "motion"],
      "warning_codes": {"boundary": "ODD-ACC-LAT-NEAR", "outside": "ODD-ACC-LAT-001"}
    },
    {
      "element_id": "ODC.2.1.4.lon_accel",
      "path": ["车辆运动状态", "加速度", "运行加速度", "纵向"],
      "label_zh": "纵向加速度",
      "requirement": "allowed",
      "rule_type": "numeric_range",
      "observation_key": "vehicle.lon_accel_mps2",
      "op": "between",
      "range": [-10.0, 2.0],
      "boundary_margin": {"mode": "absolute", "value": 0.5},
      "tags": ["vehicle", "motion"],
      "warning_codes": {"boundary": "ODD-ACC-LON-NEAR", "outside": "ODD-ACC-LON-001"}
    },
    {
      "element_id": "ODC.3.1.1.visibility",
      "path": ["天气环境", "颗粒物", "能见度"],
      "label_zh": "能见度",
      "requirement": "allowed",
      "rule_type": "numeric_range",
      "observation_key": "environment.visibility_m",
      "op": ">=",
      "threshold": 200.0,
      "boundary_margin": {"mode": "absolute", "value": 30.0},
      "tags": ["environment", "weather"],
      "warning_codes": {"boundary": "ENV-VIS-NEAR", "outside": "ENV-VIS-001"}
    },
    {
      "element_id": "ODC.3.1.2.rain_intensity",
      "path": ["天气环境", "天气", "雨"],
      "label_zh": "降雨强度",
      "requirement": "allowed",
      "rule_type": "numeric_range",
      "observation_key": "environment.rain_mm_per_h",
      "op": "<=",
      "threshold": 14.9,
      "boundary_margin": {"mode": "absolute", "value": 1.5},
      "tags": ["environment", "weather"],
      "warning_codes": {"boundary": "ENV-RAIN-NEAR", "outside": "ENV-RAIN-002"}
    },
    {
      "element_id": "ODC.3.1.3.snow_level",
      "path": ["天气环境", "天气", "雪", "降雪"],
      "label_zh": "降雪",
      "requirement": "allowed",
      "rule_type": "qualitative_enum",
      "observation_key": "environment.snow_level",
      "allowed_values": ["none", "light"],
      "boundary_values": ["moderate"],
      "forbidden_values": ["heavy", "blizzard"],
      "tags": ["environment", "weather"],
      "warning_codes": {"boundary": "ENV-SNOW-NEAR", "outside": "ENV-SNOW-001"}
    },
    {
      "element_id": "ODC.3.1.4.illumination",
      "path": ["天气环境", "光照", "自然光源"],
      "label_zh": "环境照度",
      "requirement": "allowed",
      "rule_type": "numeric_range",
      "observation_key": "environment.illumination_lux",
      "op": ">=",
      "threshold": 50.0,
      "boundary_margin": {"mode": "absolute", "value": 10.0},
      "tags": ["environment", "illumination"],
      "warning_codes": {"boundary": "ILL-LUX-NEAR", "outside": "ILL-LUX-001"}
    },
    {
      "element_id": "ODC.3.1.5.glare",
      "path": ["天气环境", "光照", "眩光"],
      "label_zh": "强眩光/逆光",
      "requirement": "not_allowed",
      "rule_type": "qualitative_bool",
      "observation_key": "environment.glare",
      "expect": true,
      "tags": ["environment", "illumination"],
      "warning_codes": {"outside": "ILL-GLARE-01"}
    },
    {
      "element_id": "ODC.3.1.6.fog",
      "path": ["天气环境", "颗粒物", "雾"],
      "label_zh": "雾/浓雾",
      "requirement": "not_allowed",
      "rule_type": "qualitative_bool",
      "observation_key": "environment.fog",
      "expect": true,
      "tags": ["environment", "weather"],
      "warning_codes": {"outside": "ENV-FOG-02"}
    },
    {
      "element_id": "ODC.4.1.1.pedestrian",
      "path": ["目标物", "行人"],
      "label_zh": "行人",
      "requirement": "not_allowed",
      "rule_type": "qualitative_bool",
      "observation_key": "dynamic.pedestrians_present",
      "expect": true,
      "tags": ["dynamic", "vru"],
      "warning_codes": {"outside": "DYN-VRU-01"}
    },
    {
      "element_id": "ODC.4.1.2.two_wheeler",
      "path": ["目标物", "非机动车"],
      "label_zh": "两轮/三轮车",
      "requirement": "not_allowed",
      "rule_type": "qualitative_bool",
      "observation_key": "dynamic.two_wheelers_present",
      "expect": true,
      "tags": ["dynamic", "vru"],
      "warning_codes": {"outside": "DYN-VRU-03"}
    },
    {
      "element_id": "ODC.4.1.3.animal",
      "path": ["目标物", "动物"],
      "label_zh": "动物(>0.3m)",
      "requirement": "allowed",
      "rule_type": "numeric_range",
      "observation_key": "dynamic.animals_over_0_3m",
      "op": "<=",
      "threshold": 0.0,
      "boundary_margin": {"mode": "absolute", "value": 0.0},
      "tags": ["dynamic", "obstacle"],
      "warning_codes": {"outside": "DYN-ANM-01"}
    },
    {
      "element_id": "ODC.4.1.4.obstacle",
      "path": ["目标物", "障碍物"],
