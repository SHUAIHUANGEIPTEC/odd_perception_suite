      "warning_codes": {"outside": "ODC-MAP-001"}
    },
    {
      "element_id": "ODC.6.1.2.ads_fault",
      "path": ["系统状态", "关联控制器"],
      "label_zh": "无 ADS 故障",
      "requirement": "allowed",
      "rule_type": "qualitative_bool",
      "observation_key": "vehicle.ads_fault",
