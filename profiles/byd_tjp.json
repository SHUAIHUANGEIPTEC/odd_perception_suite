      "tags": ["dynamic", "obstacle"],
      "warning_codes": {"outside": "DYN-STA-01"}
    },
    {
      "element_id": "ODC.5.1.1.seatbelt",
      "path": ["用户状态", "驾驶员", "安全带状态"],
      "label_zh": "安全带",
      "requirement": "not_allowed",
      "rule_type": "qualitative_bool",
      "observation_key": "vehicle.seatbelt_on",
      "expect": false,
      "tags": ["driver", "odc"],
      "warning_codes": {"outside": "ODC-BELT-001"}
    },
    {
      "element_id": "ODC.5.1.2.driver_in_seat",
