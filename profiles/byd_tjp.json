    {
      "element_id": "ODC.7.1.2.lidar_degraded",
      "path": ["传感器状态", "激光雷达"],
      "label_zh": "激光雷达退化",
      "requirement": "not_allowed",
      "rule_type": "qualitative_bool",
      "observation_key": "sensors.lidar_degraded",
      "expect": true,
      "tags": ["sensor", "perception"],
      "warning_codes": {"outside": "PER-DEG-02"}
