      "requirement": "allowed",
      "rule_type": "numeric_range",
      "observation_key": "vehicle.driver_eyes_closed_s",
      "op": "<=",
      "threshold": 30.0,
      "boundary_margin": {"mode": "absolute", "value": 5.0},
      "tags": ["driver", "odc"],
      "warning_codes": {"boundary": "ODC-DMS-NEAR", "outside": "ODC-DMS-001"}
    },
    {
      "element_id": "ODC.5.1.4.driver_attention",
      "path": ["用户状态", "驾驶员", "接管能力"],
