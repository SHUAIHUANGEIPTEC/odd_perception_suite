      "element_id": "ODC.7.1.3.camera_confidence",
      "path": ["传感器状态", "摄像头置信度"],
      "label_zh": "摄像头置信度",
      "requirement": "allowed",
      "rule_type": "numeric_range",
      "observation_key": "sensors.confidence_camera",
      "op": ">=",
      "threshold": 0.6,
      "boundary_margin": {"mode": "absolute", "value": 0.05},
      "tags": ["sensor", "perception"],
      "warning_codes": {"boundary": "PER-CAM-CONF-NEAR", "outside": "PER-CONF-001"}
