    {
      "element_id": "ODC.7.1.4.lidar_confidence",
      "path": ["传感器状态", "激光雷达置信度"],
      "label_zh": "激光雷达置信度",
      "requirement": "allowed",
      "rule_type": "numeric_range",
      "observation_key": "sensors.confidence_lidar",
      "op": ">=",
      "threshold": 0.6,
      "boundary_margin": {"mode": "absolute", "value": 0.05},
      "tags": ["sensor", "perception"],
      "warning_codes": {"boundary": "PER-LIDAR-CONF-NEAR", "outside": "PER-CONF-002"}
    },
    {
      "element_id": "ODC.7.1.5.robc",
      "path": ["传感器状态", "综合运行置信度"],
      "label_zh": "综合运行置信度(ROBC)",
